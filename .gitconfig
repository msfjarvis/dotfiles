[advice]
	skippedCherryPicks = false

[alias]
	a = add
	branches = branch -r --sort='-authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)'
	ca = commit -a
	cam = commit -am
	c = commit
	cpa = cherry-pick --abort
	cpc = cherry-pick --continue
	cp = cherry-pick --signoff
	dc = diff --cached
	dcs = diff --stat --cached
	d = diff
	dsc = diff --stat --cached
	ds = diff --stat
	export = archive --format zip --output
	fix = ca --fixup
	kang = commit --amend --reset-author
	loa = log --oneline --author='Harsh Shandilya'
	loc = log --oneline --committer='Harsh Shandilya'
	lof = log --format=fixes
	lo = log --oneline
	los = log --oneline --stat
	lst = ls-tree --full-tree -r HEAD
	pf = push --force-with-lease
	rc = rebase --continue
	ru = remote update --prune
	rv = remote -v
	squash = rebase -i --autosquash
	ss = show --stat
	s = status
	suicide = reset --hard
	su = submodule update --init --recursive

[color]
	ui = true

[core]
	abbrev = 12

[diff]
	colorMoved = default

[diff "gpg"]
	textconv = gpg --no-tty --decrypt -q

[fetch]
	showForcedUpdates = true

[gc]
	auto = 0

[http]
	postBuffer = 524288000

[init]
	defaultBranch = main

[log]
	follow = true

[merge]
	conflictstyle = diff3
	log = true

[pretty]
	fixes = Fixes: %h (\"%s\")

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[rerere]
	enabled = true

[user]
	email = me@msfjarvis.dev
	name = Harsh Shandilya

[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	verbose = true

[core]
	attributesfile = "~/.gitattributes"
	autocrlf = "input"

[diff]
	algorithm = "histogram"
	colorMoved = "plain"
	mnemonicPrefix = true
	renames = true

[fetch]
	all = true
	fsckobjects = true
	prune = true
	pruneTags = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = "openpgp"

[help]
	autocorrect = "prompt"

[init]
	defaultBranch = "main"

[log]
	date = "iso"

[merge]
	conflictstyle = "zdiff3"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "simple"
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[receive]
	fsckObjects = true

[rerere]
	autoupdate = true
	enabled = true

[tag]
	sort = "version:refname"

[transfer]
	fsckobjects = true
