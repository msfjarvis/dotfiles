#!/usr/bin/env bash
if [[ $# -lt 2 ]]; then
  echo 'usage: git rewrite <sed-expression> <revision-range>' >&2
  exit 2
fi
export GIT_REWRITE_SED=$1
shift
GIT_SEQUENCE_EDITOR='perl -pi -e s/^pick\\ /reword\\ /' \
  GIT_EDITOR="sh -c 'sed \"\$GIT_REWRITE_SED\" \"\$1\" > \"\$1.tmp\" && cat \"\$1.tmp\" > \"\$1\" && rm \"\$1.tmp\"' sh" \
  git rebase -i "$@"
